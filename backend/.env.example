DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antigravity?schema=public"
PORT=3001
# Optional — without this, new questions get a local fallback mind map (still saved once).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional separate model for the reviewer pass (defaults to OPENAI_MODEL).
OPENAI_REVIEW_MODEL=

# Optional: enable fuzzy "same question" matching (run once):
# psql $DATABASE_URL -f prisma/sql/pg_trgm.sql

# First-time / after schema changes:
# npx prisma db push && npm run dev
