DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antigravity?schema=public"
PORT=3001
# Optional: when set, first-time rabbit holes use OpenAI instead of offline templates
OPENAI_API_KEY=
# Shared fallback when writer/reviewer vars are unset
OPENAI_MODEL=gpt-4o-mini
OPENAI_WRITER_MODEL=gpt-4o-mini
OPENAI_REVIEWER_MODEL=gpt-4o
GENERATION_MAX_REVIEW_ROUNDS=2
GENERATION_AUDIT_LOG=0
